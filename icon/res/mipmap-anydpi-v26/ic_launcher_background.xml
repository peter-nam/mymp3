<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Canvas - Soft, Warm Natural Gray (#FAFAFA) -->
    <path
        android:pathData="M0,0 h108 v108 h-108 z"
        android:fillColor="#FFF6F5F2" />

    <!-- Group to maintain center & soft perspective -->
    <group>
        <!-- Abstract Deep Violet Gradient (top/left) -->
        <path
            android:pathData="M 32,32 C 16,38 12,62 26,76 C 40,90 64,88 72,72 C 80,56 70,30 52,24 C 38,19 40,28 32,32 Z"
            android:fillAlpha="0.45">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="20"
                    android:startY="20"
                    android:endX="65"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF431282" /> <!-- Deep Purple -->
                    <item android:offset="0.5" android:color="#FF7B2CBF" /> <!-- Soft Violet -->
                    <item android:offset="1.0" android:color="#007B2CBF" /> <!-- Fadeout -->
                </gradient>
            </aapt:attr>
        </path>

        <!-- Abstract Electric Blue Gradient (bottom/left) -->
        <path
            android:pathData="M 24,44 C 18,58 26,78 44,82 C 62,86 74,74 74,58 C 74,42 54,34 44,38 C 34,42 28,34 24,44 Z"
            android:fillAlpha="0.55">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="15"
                    android:startY="40"
                    android:endX="60"
                    android:endY="85"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF0077B6" /> <!-- Ocean Blue -->
                    <item android:offset="0.6" android:color="#FF00B4D8" /> <!-- Vibrant Sky Blue -->
                    <item android:offset="1.0" android:color="#0000B4D8" /> <!-- Fadeout -->
                </gradient>
            </aapt:attr>
        </path>

        <!-- Abstract Coral & Warm Pink Gradient (bottom/right to center) -->
        <path
            android:pathData="M 46,38 C 58,26 80,34 84,52 C 88,70 74,86 58,82 C 42,78 44,58 40,52 C 36,46 38,44 46,38 Z"
            android:fillAlpha="0.50">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="40"
                    android:startY="35"
                    android:endX="80"
                    android:endY="80"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFFF4D6D" /> <!-- Vibrant Pink -->
                    <item android:offset="0.6" android:color="#FFFF9E00" /> <!-- Coral/Orange -->
                    <item android:offset="1.0" android:color="#00FF9E00" /> <!-- Fadeout -->
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>